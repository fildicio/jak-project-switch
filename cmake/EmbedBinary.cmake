# cmake/EmbedBinary.cmake — turn a binary file into a C header (AI-assisted)
#
# Run as a CMake script:
#   cmake -DIN=<binary path> -DOUT=<header path> -DNAME=<C identifier> \
#         -P cmake/EmbedBinary.cmake
#
# Embeds a compiled .dksh shader so the NRO carries the shader inside it
# (no shader files on the SD card).
#
# Inputs (passed with -D):
#   IN   - path to the binary file to embed
#   OUT  - path to the C header to generate
#   NAME - C identifier used for the symbol (e.g. splash_vert)

# --- Validate inputs ---------------------------------------------------------
if(NOT DEFINED IN OR NOT DEFINED OUT OR NOT DEFINED NAME)
    message(FATAL_ERROR "EmbedBinary.cmake requires -DIN, -DOUT and -DNAME")
endif()

if(NOT EXISTS "${IN}")
    message(FATAL_ERROR "EmbedBinary: input file not found: ${IN}")
endif()

# --- 1. Read the binary as a hex string -------------------------------------
file(READ "${IN}" hex HEX)

if(NOT DEFINED hex OR hex STREQUAL "")
    message(FATAL_ERROR "EmbedBinary: input file is empty: ${IN}")
endif()

# --- 2. hex "ABCD..." -> "0xAB,0xCD,..." bytes ------------------------------
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
# Break the line after every 16th byte. CMake regex has no {n} repeat, so the 16
# groups are spelled out.
set(_b "0x[0-9a-f][0-9a-f],")
string(REGEX REPLACE "(${_b}${_b}${_b}${_b}${_b}${_b}${_b}${_b}${_b}${_b}${_b}${_b}${_b}${_b}${_b}${_b})" "\\1\n    " bytes "${bytes}")

# --- 3. Byte count = (string length of hex) / 2 -----------------------------
string(LENGTH "${hex}" hexlen)
math(EXPR nbytes "${hexlen} / 2")

get_filename_component(inname "${IN}" NAME)

# --- 4. Build the header content --------------------------------------------
set(content "// Generated by cmake/EmbedBinary.cmake from ${inname}. Do not edit. (AI-assisted)\n")
string(APPEND content "#pragma once\n")
string(APPEND content "#include <stdint.h>\n")
string(APPEND content "alignas(256) static const uint8_t ${NAME}[] = {\n")
string(APPEND content "    ${bytes}\n")
string(APPEND content "};\n")
string(APPEND content "static const uint32_t ${NAME}_size = ${nbytes};\n")

# --- 5. Only rewrite OUT if the content changed (avoids needless rebuilds) --
if(EXISTS "${OUT}")
    file(READ "${OUT}" oldcontent)
    if(content STREQUAL oldcontent)
        return()
    endif()
endif()

file(WRITE "${OUT}" "${content}")
