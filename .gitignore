# Local binary backups (contains NROs) -- never commit binaries
/backups/
# Hardware crash reports / game logs (contain game-owned strings & dumps)
/switch-crash-reports/
# Safety net: never commit Switch binaries anywhere in the tree
*.nro
*.nsp
*.kip
# Extracted game assets -- never redistribute; regenerate with the extractor from your own copy
/iso_data/
# Disc images -- never commit, these are the original game data
*.iso
*.ISO
*.cue
*.img
*.mds
*.mdf
*.chd

# Local AI/session handoff notes -- contains local paths and debugging context, not for publication
/SWITCH_PORT_SESSION_NOTES.md

# Upstream OpenGOAL CI / community config -- kept locally for reference, but not published
# from this fork: the workflows target upstream's x86-64 release pipeline and would fail or
# push to upstream-owned repos, and the issue templates/translation config are theirs.
/.github/
/crowdin.yml
